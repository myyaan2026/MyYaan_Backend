PORT=3001

# Supabase PostgreSQL connection string. URL-encode reserved password characters.
# database password from Supabase; URL-encode reserved password characters.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:MyYaan@@2026@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Local PostgreSQL fallback when DATABASE_URL is not set.
# DB_USER=postgres
# DB_HOST=localhost
# DB_DATABASE=myyaan
# DB_DBPORT=5432
# DB_PASSWORD=your_database_password

# Required for remote providers such as Supabase. Leave false for local PostgreSQL.
# DB_SSL=false

# Authentication session lifetime. Change this value without changing code.
AUTH_TOKEN_EXPIRY_DAYS=30
